@@ -0,0 +1,134 @@
+package model_adapters
+
+import agent_domain as domain
+import llm4cj.*
+import std.unittest.*
+import std.unittest.testmacro.*
+
+class TranscriptFixtureTransport <: ProviderTransport {
+    var response = ""
+    var posts: Int64 = 0
+    var body = ""
+    var headers = Array<ProviderHeader>()
+    public func post(provider: ProviderSpec, payload: String, streaming: Bool, requestId: String, chunks: (String) -> Unit): domain.Result<String> {
+        let _ = requestId
+        posts++; body = payload; headers = provider.modelHeaders
+        if (streaming) { chunks(response) }
+        domain.Result.Ok(response)
+    }
+}
+
+func exchangeFixtureProvider(): ProviderSpec {
+    ProviderSpec("fixture", ProviderProtocol.Responses, "fixture-model", "https://provider.example", "FIXTURE_KEY")
+}
+func exchangeFixtureCodec(native!: Bool = true): LlmWireCodec {
+    let endpoint = "https://provider.example/v1/responses"
+    let profile: ?LlmWireEndpointProfile = if (native) { Some(LlmWireEndpointProfile(
+        "fixture.responses.ordered", "fixture-model", "openai.responses.v1", endpoint, 1,
+        LlmWireContextUpdateCapabilities(toolDeclaration: true), "offline fixture", "2026-10-01"
+    )) } else { None }
+    openAiResponsesCodec(openAiResponsesModelProfile("fixture-model", endpoint: endpoint,
+        capabilities: LlmWireCapabilities(tools: LlmWireToolCapabilities(enabled: true)), endpointProfile: profile))
+}
+func exchangeJson(source: String): LlmWireJson {
+    match (LlmWireJson.parse(source)) { case LlmWireResult.Ok(value) => value; case LlmWireResult.Err(error) => throw error }
+}
+func exchangeDeclaration(name: String): LlmWireToolDeclaration {
+    LlmWireToolDeclaration(LlmWireTool(name, "definition " + name, exchangeJson("{}")), version: "1")
+}
+func exchangeFixtureTranscript(): LlmWireTranscript {
+    let history = StringBuilder()
+    for (_ in 0..128) { history.append("unchanged history record; ") }
+    LlmWireTranscript(LlmWireInitialContext(
+        instructions: [LlmWireInstruction(LlmWireInstructionRole.System, "unchanged instruction")],
+        tools: [exchangeDeclaration("tool_a"), exchangeDeclaration("tool_b")]
+    ), items: [
+        LlmWireInputItem.Message(LlmWireMessage(LlmWireRole.User, [LlmWireBlock.Text(LlmWireTextBlock(history.toString()))])),
+        LlmWireInputItem.ToolDeclaration(exchangeDeclaration("tool_c"))
+    ])
+}
+func exchangeFixtureReply(name!: String = "tool_c"): String {
+    "{\"id\":\"reply\",\"status\":\"completed\",\"output\":[{\"type\":\"function_call\",\"call_id\":\"new-call\",\"name\":\"" + name + "\",\"arguments\":\"{}\"}],\"usage\":{\"input_tokens\":11,\"output_tokens\":2}}"
+}
+
+@Test
+class ProviderTranscriptExchangeTests {
+    @TestCase
+    func nativeFixedCallResultAndReplayPreserveOriginalInput(): Unit {
+        let provider = exchangeFixtureProvider()
+        let codec = exchangeFixtureCodec()
+        let transport = TranscriptFixtureTransport()
+        transport.response = exchangeFixtureReply()
+        let transcript = exchangeFixtureTranscript()
+        let port = ProviderTranscriptPort(provider, codec, transport)
+        let reply = match (port.execute(LlmWireRequest("fixture-model", transcript))) {
+            case domain.Result.Ok(value) => value
+            case domain.Result.Err(error) => throw IllegalStateException(error.describe())
+        }
+        @Expect(transport.posts, 1)
+        @Expect(reply.blocks[0].name, "tool_c")
+        @Expect(reply.blocks[0].callId, "new-call")
+        let replay = transcript.append(LlmWireInputItem.Message(LlmWireMessage(LlmWireRole.Assistant, [
+            LlmWireBlock.ToolCall(LlmWireToolCallBlock(reply.blocks[0].callId, reply.blocks[0].name,
+                LlmWireToolArguments.Complete(agentValueLlmJson(reply.blocks[0].arguments))))
+        ]))).append(LlmWireInputItem.Message(LlmWireMessage(LlmWireRole.User, [
+            LlmWireBlock.ToolResult(LlmWireToolResultBlock("new-call", [LlmWireToolResultContent.Text(LlmWireTextBlock("done"))]))
+        ])))
+        let replayExchange = ProviderTranscriptExchange(provider, codec, LlmWireRequest("fixture-model", replay))
+        let first = exchangeJson(transport.body)
+        let second = exchangeJson(replayExchange.body)
+        @Expect(first.field("tools").getOrThrow().values().size, 2)
+        @Expect(second.field("tools").getOrThrow().stringify(), first.field("tools").getOrThrow().stringify())
+        let prefix = first.field("input").getOrThrow().values()
+        let replayInput = second.field("input").getOrThrow().values()
+        @Expect(replayInput.size > prefix.size, true)
+        for (index in 0..prefix.size) { @Expect(replayInput[index].stringify(), prefix[index].stringify()) }
+        @Expect(prefix[prefix.size - 1].field("type").getOrThrow().stringValue(), Some("additional_tools"))
+        let snapshot = match (replay.snapshot()) { case LlmWireResult.Ok(value) => value; case LlmWireResult.Err(error) => throw error }
+        let restored = match (LlmWireTranscript.restore(snapshot)) { case LlmWireResult.Ok(value) => value; case LlmWireResult.Err(error) => throw error }
+        @Expect(ProviderTranscriptExchange(provider, codec, LlmWireRequest("fixture-model", restored)).body, replayExchange.body)
+    }
+
+    @TestCase
+    func nativeStreamReplyUsesTheSameTypedOrigin(): Unit {
+        let transport = TranscriptFixtureTransport()
+        transport.response = "event: response.completed\ndata: {\"type\":\"response.completed\",\"response\":" + exchangeFixtureReply() + "}\n\n"
+        let port = ProviderTranscriptPort(exchangeFixtureProvider(), exchangeFixtureCodec(), transport)
+        match (port.execute(LlmWireRequest("fixture-model", exchangeFixtureTranscript()), streaming: true)) {
+            case domain.Result.Ok(reply) => @Expect(reply.blocks[0].name, "tool_c"); @Expect(reply.blocks[0].callId, "new-call")
+            case domain.Result.Err(error) => @Fail(error.describe())
+        }
+        @Expect(transport.posts, 1)
+        @Expect(exchangeJson(transport.body).field("stream").getOrThrow().booleanValue(), Some(true))
+    }
+
+    @TestCase
+    func nativePreflightRejectsUnsupportedBeforeTransport(): Unit {
+        let transport = TranscriptFixtureTransport()
+        let port = ProviderTranscriptPort(exchangeFixtureProvider(), exchangeFixtureCodec(native: false), transport)
+        match (port.execute(LlmWireRequest("fixture-model", exchangeFixtureTranscript()))) {
+            case domain.Result.Err(error) =>
+                @Expect(error.code, "llm.context_update_unsupported")
+                @Expect(error.fallbackAllowed, false)
+                @Expect(error.field("llm_missing_capability"), Some("tool_declaration"))
+            case _ => @Fail("missing native capability must fail preflight")
+        }
+        @Expect(transport.posts, 0)
+    }
+
+    @TestCase
+    func generatedUnknownToolKeepsObservedUsageAndForbidsFallback(): Unit {
+        let transport = TranscriptFixtureTransport()
+        transport.response = exchangeFixtureReply(name: "unknown")
+        let port = ProviderTranscriptPort(exchangeFixtureProvider(), exchangeFixtureCodec(), transport)
+        match (port.execute(LlmWireRequest("fixture-model", exchangeFixtureTranscript()))) {
+            case domain.Result.Err(error) =>
+                @Expect(error.code, "llm.tool_reference_unknown")
+                @Expect(error.fallbackAllowed, false)
+                @Expect(error.field("usage_input_tokens"), Some("11"))
+                @Expect(error.field("usage_cache_read_tokens").isNone(), true)
+            case _ => @Fail("generated unknown tools must fail admission")
+        }
+        @Expect(transport.posts, 1)
+    }
+}

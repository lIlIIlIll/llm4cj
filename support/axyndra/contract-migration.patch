diff --git a/model_adapters/src/transcript_exchange.cj b/model_adapters/src/transcript_exchange.cj
new file mode 100644
index 0000000..a0ab980
--- /dev/null
+++ b/model_adapters/src/transcript_exchange.cj
@@ -0,0 +1,173 @@
+package model_adapters
+
+import agent_domain as domain
+import llm4cj.*
+import std.collection.*
+
+// This entry accepts one typed input fact. It never projects a second
+// ModelRequest.tools/messages view over the caller's ordered transcript.
+public class ProviderTranscriptExchange {
+    public let transcript: LlmWireTranscript
+    public let body: String
+    private let headersValue: Array<ProviderHeader>
+    private let codec: LlmWireCodec
+    private let provider: ProviderSpec
+    private let streaming: Bool
+
+    public init(provider: ProviderSpec, codec: LlmWireCodec, request: LlmWireRequest, streaming!: Bool = false) {
+        let protocol = match (provider.protocol) {
+            case ProviderProtocol.Messages => LlmWireProtocol.Messages
+            case ProviderProtocol.Responses => LlmWireProtocol.Responses
+            case ProviderProtocol.Completions => LlmWireProtocol.ChatCompletions
+        }
+        let profile = match (codec.modelProfile) {
+            case Some(value) => value
+            case None => throw LlmWireError(LlmWireErrorKind.InvalidRequest,
+                "llm.model_profile_required", "typed transcript exchanges require an exact model/endpoint profile")
+        }
+        if (request.model != provider.model || profile.model != provider.model ||
+            codec.protocol != protocol || profile.endpoint != provider.endpoint()) {
+            throw LlmWireError(LlmWireErrorKind.InvalidRequest,
+                "llm.model_profile_mismatch", "transcript exchange codec must match the selected model, protocol and endpoint")
+        }
+        let materialized = match (codec.encodeRequest(request, streaming: streaming).materialize(
+            resolver: Some(ProviderRequirementResolver(provider.messagesFastMode))
+        )) {
+            case LlmWireResult.Ok(value) => value
+            case LlmWireResult.Err(error) => throw error
+        }
+        let headers = ArrayList<ProviderHeader>()
+        for (header in provider.modelHeaders) { addOrReplaceProviderHeader(headers, header) }
+        for (header in materialized.headers) { addOrReplaceProviderHeader(headers, ProviderHeader(header.name, header.value)) }
+        this.provider = provider; this.codec = codec; this.streaming = streaming
+        this.transcript = request.transcript; this.body = String.fromUtf8(materialized.body)
+        this.headersValue = headers.toArray()
+    }
+
+    public prop headers: Array<ProviderHeader> { get() { headersValue.clone() } }
+
+    public func decode(source: String): domain.Result<domain.ModelReply> {
+        var observed: ?LlmWireUsage = None
+        try {
+            let terminal = if (streaming) {
+                let decoder = codec.newStreamDecoder()
+                let toolCallIds = HashMap<String, String>()
+                let line = ArrayList<Byte>()
+                // Retained transport bodies use the same bounded per-line
+                // replay as the existing adapter, independent of buffering.
+                for (byte in source.toArray()) {
+                    line.add(byte)
+                    if (byte == b'\n' || byte == b'\r') {
+                        let _ = pushStreamReplayChunk(decoder, line.toArray(), provider.protocol, {_ => ()}, toolCallIds)
+                        line.clear()
+                    }
+                }
+                if (!line.isEmpty()) {
+                    let _ = pushStreamReplayChunk(decoder, line.toArray(), provider.protocol, {_ => ()}, toolCallIds)
+                }
+                match (decoder.finish()) {
+                    case LlmWireResult.Ok(update) => match (update.terminal) {
+                        case Some(value) => value
+                        case None => throw LlmWireError(LlmWireErrorKind.InvalidWire,
+                            "llm.stream_terminal_missing", "transcript exchange requires a terminal stream reply")
+                    }
+                    case LlmWireResult.Err(error) => throw error
+                }
+            } else {
+                let state = match (codec.decodeResponse(LlmWireHttpResponse(200, [], source.toArray()))) {
+                    case LlmWireResult.Ok(value) => value
+                    case LlmWireResult.Err(error) => throw error
+                }
+                match (state) {
+                    case LlmWireResponseState.Terminal(value) => value
+                    case _ => throw LlmWireError(LlmWireErrorKind.InvalidWire,
+                        "llm.pending_response_unaccepted", "transcript exchange requires a terminal fixed reply")
+                }
+            }
+            observed = match (terminal) {
+                case LlmWireTerminal.Completed(value) => Some(value.usage)
+                case LlmWireTerminal.ProviderFailed(value) => value.usage
+                case LlmWireTerminal.Cancelled(value) => value.usage
+            }
+            let reply = completedWireReply(terminal)
+            // Identity visibility is unconditional; tool-runtime still owns
+            // argument-schema failures after this admission barrier.
+            match (validateReplyToolInputs(reply, transcript, mode: LlmWireToolInputValidationMode.Disabled)) {
+                case LlmWireResult.Ok(_) => ()
+                case LlmWireResult.Err(error) => throw error
+            }
+            domain.Result.Ok(fromLlmWireReply(reply, provider.id, provider.protocol, streaming))
+        } catch (error: LlmWireError) {
+            domain.Result.Err(transcriptExchangeError(provider, error, observed))
+        }
+    }
+}
+
+// Transport, credentials and endpoint selection remain owned by the host.
+// Requests are sent exactly as prepared; this port has no retry/fallback loop.
+public class ProviderTranscriptPort {
+    private let provider: ProviderSpec
+    private let codec: LlmWireCodec
+    private let transport: ProviderTransport
+    public init(provider: ProviderSpec, codec: LlmWireCodec, transport: ProviderTransport) {
+        this.provider = provider; this.codec = codec; this.transport = transport
+    }
+    public func execute(request: LlmWireRequest, streaming!: Bool = false, requestId!: String = ""): domain.Result<domain.ModelReply> {
+        let exchange = try { ProviderTranscriptExchange(provider, codec, request, streaming: streaming) }
+        catch (error: LlmWireError) { return domain.Result.Err(transcriptExchangeError(provider, error, None)) }
+        let wireProvider = ProviderSpec(
+            provider.id, provider.protocol, provider.model, provider.baseUrl, provider.apiKeyEnv,
+            credentialFile: provider.credentialFile, timeoutMillis: provider.timeoutMillis,
+            provider: provider.provider, messagesFastMode: provider.messagesFastMode,
+            dialect: Some(provider.dialect), endpointMaxOutputTokens: provider.endpointMaxOutputTokens,
+            capabilities: provider.capabilities, profileHeaders: provider.profileHeaders,
+            allowInsecureHttp: provider.allowInsecureHttp, modelHeaders: exchange.headers,
+            networkPolicy: Some(provider.networkPolicy)
+        )
+        match (transport.post(wireProvider, exchange.body, streaming, requestId, {_ => ()})) {
+            case domain.Result.Ok(body) => exchange.decode(body)
+            case domain.Result.Err(error) => domain.Result.Err(domain.AgentError(
+                error.kind, error.code, error.message, retryable: error.retryable,
+                fallbackAllowed: false, fields: error.fields, attemptFailure: error.attemptFailure
+            ))
+        }
+    }
+    public func cancel(requestId: String): domain.Result<Unit> { transport.cancel(requestId) }
+}
+
+func transcriptExchangeError(provider: ProviderSpec, error: LlmWireError, observed: ?LlmWireUsage): domain.AgentError {
+    let fields = ArrayList<domain.ErrorField>()
+    fields.add(domain.ErrorField("provider_id", provider.id))
+    fields.add(domain.ErrorField("llm_error_kind", llmWireErrorKindName(error.kind)))
+    fields.add(domain.ErrorField("llm_input_item_index", error.inputItemIndex.toString()))
+    fields.add(domain.ErrorField("llm_tool_name", error.toolName))
+    fields.add(domain.ErrorField("llm_tool_version", error.toolVersion))
+    fields.add(domain.ErrorField("llm_missing_capability", error.missingCapability))
+    fields.add(domain.ErrorField("llm_profile_id", error.profileId))
+    fields.add(domain.ErrorField("llm_contract_version", error.contractVersion.toString()))
+    let usage = match (error.usage) { case Some(value) => Some(value); case None => observed }
+    match (usage) {
+        case Some(value) =>
+            match (value.source) {
+                case LlmWireUsageSource.ProviderReported(providerId, dialectId) =>
+                    fields.add(domain.ErrorField("usage_source_provider", providerId))
+                    fields.add(domain.ErrorField("usage_source_dialect", dialectId))
+                case LlmWireUsageSource.Unknown => ()
+            }
+            if (value.inputTokens.isSome() || value.cacheReadTokens.isSome() || value.cacheWriteTokens.isSome()) {
+                fields.add(domain.ErrorField("usage_input_tokens", providerInputUsageTotal(provider.protocol, value).toString()))
+            }
+            for ((name, bucket) in [
+                ("usage_output_tokens", value.outputTokens),
+                ("usage_cache_read_tokens", value.cacheReadTokens),
+                ("usage_cache_write_tokens", value.cacheWriteTokens)
+            ]) { match (bucket) { case Some(tokens) => fields.add(domain.ErrorField(name, tokens.toString())); case None => () } }
+        case None => ()
+    }
+    domain.AgentError(
+        if (error.kind == LlmWireErrorKind.InvalidRequest || error.kind == LlmWireErrorKind.Unsupported) {
+            domain.AgentErrorKind.InvalidInput
+        } else { domain.AgentErrorKind.Protocol },
+        error.code, error.message, retryable: false, fallbackAllowed: false, fields: fields.toArray()
+    )
+}
